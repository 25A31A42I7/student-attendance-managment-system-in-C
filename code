#include <stdio.h>
#include <stdlib.h>
#include <string.h>

typedef struct {
    int id;
    char name[50];
    int attendance_count;
} Student;

void add_student() {
    FILE *fp = fopen("attendance.dat", "ab");
    if (!fp) { printf("Error opening file!\n"); return; }
    
    Student s;
    printf("Enter Student ID: ");
    scanf("%d", &s.id);
    printf("Enter Student Name: ");
    scanf("%s", s.name);
    s.attendance_count = 0;
    
    fwrite(&s, sizeof(Student), 1, fp);
    fclose(fp);
    printf("Student added successfully!\n");
}

void mark_attendance() {
    FILE *fp = fopen("attendance.dat", "rb+");
    if (!fp) { printf("No records found.\n"); return; }
    
    int id, found = 0;
    Student s;
    printf("Enter Student ID to mark present: ");
    scanf("%d", &id);
    
    while (fread(&s, sizeof(Student), 1, fp)) {
        if (s.id == id) {
            s.attendance_count++;
            fseek(fp, -sizeof(Student), SEEK_CUR);
            fwrite(&s, sizeof(Student), 1, fp);
            found = 1;
            break;
        }
    }
    fclose(fp);
    if (found) printf("Attendance marked for %s!\n", s.name);
    else printf("Student ID not found.\n");
}

void view_attendance() {
    FILE *fp = fopen("attendance.dat", "rb");
    if (!fp) { printf("No records to display.\n"); return; }
    
    Student s;
    printf("\nID\tName\t\tAttendance\n");
    printf("------------------------------------\n");
    while (fread(&s, sizeof(Student), 1, fp)) {
        printf("%d\t%s\t\t%d\n", s.id, s.name, s.attendance_count);
    }
    fclose(fp);
}

int main() {
    int choice;
    while (1) {
        printf("\n--- Attendance System ---\n");
        printf("1. Add Student\n2. Mark Attendance\n3. View Records\n4. Exit\nChoice: ");
        scanf("%d", &choice);
        switch (choice) {
            case 1: add_student(); break;
            case 2: mark_attendance(); break;
            case 3: view_attendance(); break;
            case 4: exit(0);
            default: printf("Invalid choice!\n");
        }
    }
    return 0;
}
